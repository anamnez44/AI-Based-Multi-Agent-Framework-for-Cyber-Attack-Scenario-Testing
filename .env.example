# Copy to .env and adjust. Values here are the defaults.

# LLM provider: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_MAX_RETRIES=2
LLM_NUM_CTX=4096
OLLAMA_BASE_URL=http://localhost:11434

# Required only for cloud providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Closed loop
TARGET_URL=http://localhost:8080
MAX_ITERATIONS=3
